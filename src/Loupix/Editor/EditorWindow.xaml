<Window x:Class="Loupix.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:Loupix.Editor"
        Title="Loupix" Width="1000" Height="700" MinWidth="560" MinHeight="300"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar + toolbar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Image x:Name="AppIcon" DockPanel.Dock="Left" Width="18" Height="18" Margin="12,0,6,0" />

                <StackPanel x:Name="CaptionPanel" DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="OnMaximize" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnCloseClick" />
                </StackPanel>

                <StackPanel x:Name="ActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" />

                <!-- Info: image size, zoom, colour under cursor -->
                <StackPanel x:Name="InfoPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SizeButton" Style="{StaticResource IconButton}" Click="OnSizeClick" ToolTip="Image size — click to resize">
                        <TextBlock x:Name="SizeText" Text="0 × 0" FontSize="12" />
                    </Button>
                    <Button x:Name="ZoomButton" Style="{StaticResource IconButton}" Click="OnZoomClick" ToolTip="Zoom">
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                    </Button>
                    <Button x:Name="ColorButton" Style="{StaticResource IconButton}" Click="OnColorFormatClick" ToolTip="Color under cursor — Tab copies it. Click for formats and contrast.">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ColorSwatch" Width="14" Height="14" CornerRadius="3" BorderBrush="#50FFFFFF" BorderThickness="1" Background="Transparent" Margin="0,0,6,0" />
                            <TextBlock x:Name="ColorText" Text="—" FontSize="12" MinWidth="64" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource Separator}" />
                </StackPanel>

                <!-- Docked last so the caption buttons, actions and info always get their space first. -->
                <StackPanel x:Name="ToolsPanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" />
            </DockPanel>
        </Border>

        <!-- Style bar: options for the current tool or selected object -->
        <Border x:Name="StyleBar" Grid.Row="1" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Height="38" Visibility="Collapsed">
            <StackPanel x:Name="StylePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0" />
        </Border>

        <Grid Grid.Row="2">
            <ed:EditorCanvas x:Name="Canvas" />
            <!-- In-window confirmation ("Copied", "Saved"...) -->
            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Padding="14,8"
                    CornerRadius="12" Background="#E6262628" BorderBrush="#40FFFFFF" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ToastSwatch" Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0" Visibility="Collapsed" BorderBrush="#50FFFFFF" BorderThickness="1" />
                    <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <!-- A one-time tip after the very first capture. -->
            <Border x:Name="Coach" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="16,12"
                    CornerRadius="10" Background="#FF2A2A2D" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="CoachTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="CoachText" FontSize="13" Foreground="#FFC4C4CA" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
