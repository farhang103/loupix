<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. build.ps1 fills in the version and architecture.
     Identity and PublisherDisplayName must match Partner Center > Loupix > Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop rescap">

  <Identity Name="Farhang.Loupix" Publisher="CN=41681186-DD51-4A5B-BCED-5E93F63C574A" Version="$Version$" ProcessorArchitecture="$Arch$" />

  <Properties>
    <DisplayName>Loupix</DisplayName>
    <PublisherDisplayName>Farhang</PublisherDisplayName>
    <Description>A fast, free screenshot tool for Windows.</Description>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="Loupix.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Loupix"
        Description="A fast, free screenshot tool for Windows."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" Square71x71Logo="Images\Square71x71Logo.png" Square310x310Logo="Images\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="loupix" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Loupix</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="images" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Image</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <!-- Starts switched off. The Welcome window and Settings turn it on with the StartupTask API. -->
        <desktop:Extension Category="windows.startupTask" Executable="Loupix.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--background">
          <desktop:StartupTask TaskId="LoupixStartup" Enabled="false" DisplayName="Loupix" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
